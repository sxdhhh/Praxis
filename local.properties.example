# 复制为 local.properties 后按本机情况填写。
# local.properties 已被 .gitignore 排除，不要提交真实口令。
#
# Android SDK 路径（aarch64 构建机上通常是下面这个）
sdk.dir=/opt/android-sdk

# ── Praxis 运行期配置（S3：先落通道，不落真实 Key）──────────────────
# 服务商 baseUrl：会写进 BuildConfig.DEFAULT_BASE_URL
# CI 上用环境变量 PRAXIS_BASE_URL 覆盖同名项
praxis.baseUrl=https://api.example.com
# 调试用 API Key：留空即表示「运行期由设置页写入加密存储」。
# 注意：填了就会进 BuildConfig，随 APK 一起可被提取，仅限本地调试。
# CI 上用环境变量 PRAXIS_API_KEY 覆盖同名项
praxis.apiKey=

# ── release 签名（S8：只登记路径，不在仓库里放文件）──────────────────
# 口令一律走环境变量，任何情况下都不要写进本文件：
#   PRAXIS_STORE_PASS / PRAXIS_KEY_PASS / PRAXIS_KEY_ALIAS
PRAXIS_KEYSTORE=/root/.keys/praxis-release.jks
