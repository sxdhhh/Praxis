<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 及以下的备份规则（对应 android:fullBackupContent）。

    与 res/xml/data_extraction_rules.xml 同义：全部排除。两个文件都要有 ——
    低版本系统只认这个，高版本系统只认 data_extraction_rules。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>