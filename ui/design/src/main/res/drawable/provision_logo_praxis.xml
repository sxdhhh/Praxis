<?xml version="1.0" encoding="utf-8"?>
<!--
  Praxis 图标 —— 与 ic_launcher_foreground / PraxisIcons.Logo 同一条「P」形 path。

  ## 上一版为什么图标特别小

  这条 path 在原始坐标里只占 x 38~72、y 30~72（34×42），
  而 viewport 被写成了 108×108 —— 图形只占其中约 1/3。

  布局里 `logo_image` 是 90dp 固定尺寸、ImageView 默认 FIT_CENTER，
  于是 90dp 的框里只画出约 28dp 宽的字形，四周全是空白。
  原版 HyperCeiler 的矢量本身就是填满 viewport 的，所以同样的 90dp
  在原版上看起来正常 —— 问题出在 viewport，不在 90dp。

  ## 修法：viewport 收到字形的方形包围盒

  viewport = 42×42（= max(34,42)），再用 group 把字形平移到居中。
  这样同一个 90dp 容器被字形填满，XML 里一个尺寸都不用改。

  取**方形**而不是 34×42：VectorDrawable 把 viewport 映射到声明尺寸时
  X / Y 独立缩放，非方形 viewport + 方形声明会把字形横向拉扁。

  ## 为什么用 group translate 而不是改 pathData

  pathData 与 launcher 图标逐字相同，改坐标会让两处失去可对比性。
  用 group 平移把字形挪进新 viewport，path 本身保持原样。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="90dp"
    android:height="90dp"
    android:viewportWidth="42"
    android:viewportHeight="42">
    <group
        android:translateX="-34"
        android:translateY="-30">
        <path
            android:pathData="M38,30h18c9,0 15,5 15,13c0,6 -3,10 -8,12l9,17h-11l-8,-15h-4v15h-11zM49,39v10h7c3,0 4,-2 4,-5c0,-3 -1,-5 -4,-5z">
                <!-- 三色斜向渐变：品牌蓝 → 青 → 紫。原版是单色 #FFFFFF。 -->
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="0"
                        android:startY="0"
                        android:endX="42"
                        android:endY="42"
                        android:type="linear">
                        <item android:offset="0" android:color="#FF3482FF" />
                        <item android:offset="0.55" android:color="#FF00C2C7" />
                        <item android:offset="1" android:color="#FF7B4DFF" />
                    </gradient>
                </aapt:attr>
        </path>
    </group>
</vector>
